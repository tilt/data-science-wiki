{
  "name": "data-science-ml-ai-wiki",
  "description": "Personal Data Science, Machine Learning, and AI wiki built with Quartz and Obsidian",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "install-plugins": "npx tsx ./quartz/plugins/loader/install-plugins.ts && npm run patch-plugins",
    "patch-plugins": "node scripts/patch-mermaid-config.mjs && node scripts/patch-note-properties-eval.mjs",
    "prebuild": "npm run install-plugins",
    "build": "npx quartz build",
    "preview": "node scripts/serve-public.mjs",
    "preview:watch": "npm run patch-plugins && npx quartz build --serve",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "validate:content": "node scripts/validate-content.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-external-links": "node scripts/check-external-links.mjs",
    "portability-check": "node scripts/portability-check.mjs",
    "nav-footers": "node scripts/gen-nav-footers.mjs",
    "nav-footers-check": "node scripts/gen-nav-footers.mjs --check",
    "test:mermaid": "node scripts/check-mermaid-rendering.mjs"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@floating-ui/dom": "^1.7.4",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "0.1.22",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.6.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.36.3",
    "lightningcss": "^1.31.1",
    "micromorph": "^0.4.5",
    "minimatch": "^10.1.1",
    "preact": "^10.28.2",
    "preact-render-to-string": "^6.6.5",
    "pretty-bytes": "^7.1.0",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.6",
    "sharp": "^0.34.5",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.1",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.0.10",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
